@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}


<link href="~/template/app-assets/vendors/css/tables/datatable/dataTables.bootstrap4.min.css" rel="stylesheet" />
<link href="~/template/app-assets/vendors/css/tables/datatable/select.dataTables.min.css" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/template/app-assets/fonts/simple-line-icons/style.min.css">
<link href="~/template/app-assets/vendors/css/extensions/sweetalert2.min.css" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/template/app-assets/css/plugins/extensions/add-on-drag-drop.css">
<link rel="stylesheet" type="text/css" href="~/template/app-assets/vendors/css/forms/icheck/icheck.css">
<link rel="stylesheet" type="text/css" href="~/template/app-assets/vendors/css/forms/icheck/custom.css">

<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="content-wrapper">


        <!-- HEADER -->
        <div class="content-header row">
            <div class="content-header-left col-md-6 col-12 mb-2">
                <h3 class="content-header-title mb-0">Gestion papeleria oficina</h3>
                <div class="row breadcrumbs-top">
                    <div class="breadcrumb-wrapper col-12">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="../Home/Index">Inicio</a>
                            </li>
                            <li class="breadcrumb-item active">
                                Solicitud insumos papeleria
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-body">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs" id="tabsSolicitudes" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="tab-nueva-tab" data-toggle="tab" href="#tab-nueva" role="tab" aria-controls="tab-nueva" aria-selected="true">
                                <i></i> Nueva Solicitud
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="tab-misSolicitudes-tab" data-toggle="tab" href="#tab-misSolicitudes" role="tab" aria-controls="tab-misSolicitudes" aria-selected="false">
                                <i></i> Mis Solicitudes
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="card-content">
                    <div class="card-body">
                        <div class="tab-content">

                            <!-- ===================== TAB: NUEVA SOLICITUD ===================== -->
                            <div class="tab-pane active" id="tab-nueva" role="tabpanel" aria-labelledby="tab-nueva-tab">

                                @*    <div class="row">
                                    <div class="col-md-5 col-12 form-group">
                                        <label>Insumo</label>
                                        <select id="SelectInsumo" class="form-control">
                                            <option value="">Seleccione un insumo...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 col-12 form-group">
                                        <label>Cantidad</label>
                                        <input type="number" id="InputCantidad" class="form-control" min="1" value="1">
                                    </div>
                                    <div class="col-md-2 col-12 form-group">
                                        <label>Unidad</label>
                                        <input type="text" id="InputUnidadInsumo" class="form-control" readonly>
                                    </div>
                                    <div class="col-md-3 col-12 form-group d-flex align-items-end">
                                        <button type="button" id="BtnAgregarPartida" class="btn btn-primary btn-block">
                                            <i class="icon-plus"></i> Agregar a la solicitud
                                        </button>
                                    </div>
                                </div> *@
                                <div class="form-row">
                                    <div class="col-2">
                                        <label>Codigo:</label>
                                        <input type="search" id="InputCodigoArticulo" pattern="[0-9]" required class="form-control" value="" placeholder="Escríbe Código Interno" onkeypress='return validaNumericos(event)'>
                                    </div>
                                    <div class="col-2">
                                        <label>Artículo:</label>
                                        <input type="search" id="InputNombreArticulo" pattern="[0-9]" required class="form-control" value="" placeholder="Escríbe Nombre Artículo" onkeypress='return validaNumericos(event)'>
                                    </div>
                                    <div class="col" style="margin-top:28px;">
                                        <button type="button" id="btnBuscarArticulo" class="btn btn-info">Buscar</button>

                                        @*<button type="button" id="btnReporteOrdenDeDistribucion" class="btn btn-success">Cargar</button>*@
                                    </div>

                                </div>
                                <!--Tabla informacion general-->
                                <div class="row" style="overflow: scroll; height: 350px;">
                                    <div class="col-12 col-sm-12">
                                        <h5 class="font-weight-bold">Informacion de Articulo </h5>
                                        <div class="table-responsive">
                                            <table id="tblInformacionArt" class="table table-hover table-striped table-bordered">
                                                <thead style="background-color: lightslategrey">
                                                    <tr class="text-bold-300" style="color:white">
                                                        <th>Codigo</th>
                                                        <th>Articulo</th>
                                                        <th>Existencia</th>
                                                        <th>Unidades</th>
                                                        <th>Unidad Medicion</th>
                                                        <th>Acciones</th>
                                                    </tr>
                                                </thead>
                                                <!--Ejemplo-->
                                                <tbody>
                                                    <tr>
                                                        <td>ART-001</td>
                                                        <td>Hojas blancas tamaño carta</td>
                                                        <td>500</td>
                                                        <td>
                                                            <input type="number"
                                                                   class="form-control input-unidades"
                                                                   value="1"
                                                                   min="1"
                                                                   max="500"
                                                                   data-codigo="ART-001">
                                                        </td>
                                                        <td>Paquete</td>
                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-primary btn-sm btnAgregarArticulo"
                                                                    data-codigo="ART-001"
                                                                    data-articulo="Hojas blancas tamaño carta"
                                                                    data-existencia="500"
                                                                    data-unidad="Paquete">
                                                                <i class="ft-shopping-cart"></i> Agregar
                                                            </button>
                                                        </td>
                                                    </tr>

                                                    <tr>
                                                        <td>ART-002</td>
                                                        <td>Pluma tinta azul</td>
                                                        <td>120</td>
                                                        <td>
                                                            <input type="number"
                                                                   class="form-control input-unidades"
                                                                   value="1"
                                                                   min="1"
                                                                   max="120"
                                                                   data-codigo="ART-002">
                                                        </td>
                                                        <td>Pieza</td>
                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-primary btn-sm btnAgregarArticulo"
                                                                    data-codigo="ART-002"
                                                                    data-articulo="Pluma tinta azul"
                                                                    data-existencia="120"
                                                                    data-unidad="Pieza">
                                                                <i class="ft-shopping-cart"></i> Agregar
                                                            </button>
                                                        </td>
                                                    </tr>

                                                    <tr>
                                                        <td>ART-003</td>
                                                        <td>Carpeta tamaño carta</td>
                                                        <td>Agotado</td>
                                                        <td>
                                                            <input type="number"
                                                                   class="form-control input-unidades"
                                                                   value="0"
                                                                   min="0"
                                                                   max="0"
                                                                   data-codigo="ART-003">
                                                        </td>
                                                        <td>Pieza</td>
                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-primary btn-sm btnAgregarArticulo"
                                                                    data-codigo="ART-003"
                                                                    data-articulo="Carpeta tamaño carta"
                                                                    data-existencia="75"
                                                                    data-unidad="Pieza">
                                                                <i class="ft-shopping-cart"></i> Agregar
                                                            </button>
                                                        </td>
                                                    </tr>

                                                    <tr>
                                                        <td>ART-004</td>
                                                        <td>Tóner para impresora HP</td>
                                                        <td>8</td>
                                                        <td>
                                                            <input type="number"
                                                                   class="form-control input-unidades"
                                                                   value="1"
                                                                   min="1"
                                                                   max="8"
                                                                   data-codigo="ART-004">
                                                        </td>
                                                        <td>Pieza</td>
                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-primary btn-sm btnAgregarArticulo"
                                                                    data-codigo="ART-004"
                                                                    data-articulo="Tóner para impresora HP"
                                                                    data-existencia="8"
                                                                    data-unidad="Pieza">
                                                                <i class="ft-shopping-cart"></i> Agregar
                                                            </button>
                                                        </td>
                                                    </tr>

                                                    <tr>
                                                        <td>ART-005</td>
                                                        <td>Marcador permanente negro</td>
                                                        <td>50</td>
                                                        <td>
                                                            <input type="number"
                                                                   class="form-control input-unidades"
                                                                   value="1"
                                                                   min="1"
                                                                   max="50"
                                                                   data-codigo="ART-005">
                                                        </td>
                                                        <td>Caja</td>
                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-primary btn-sm btnAgregarArticulo"
                                                                    data-codigo="ART-005"
                                                                    data-articulo="Marcador permanente negro"
                                                                    data-existencia="50"
                                                                    data-unidad="Caja">
                                                                <i class="ft-shopping-cart"></i> Agregar
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                                <!--finejemplo-->
                                            </table>
                                        </div>
                                    </div>
                                </div>


                                <!--fin tabla informacion general-->




                                <div class="table-responsive mt-1">
                                    <table class="table table-bordered table-striped" id="tablaDetalleSolicitud">
                                        <thead>
                                            <tr>
                                                <th>Codigo</th>
                                                <th>Articulo</th>
                                                <th>Unidades</th>
                                                <th>Unidad Medicion</th>
                                                <th style="width:80px;">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyDetalleSolicitud">
                                            <!-- Las partidas agregadas se pintan aqui via JS -->
                                            <tr id="filaSinPartidas">
                                                <td colspan="4" class="text-center text-muted">
                                                    Aun no hay articulo en esta solicitud
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="row">
                                    <div class="col-12 form-group">
                                        <label>Observaciones</label>
                                        <textarea id="InputObservaciones" class="form-control" rows="2" placeholder="Comentarios adicionales para almacen (opcional)"></textarea>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-12 text-right">
                                        <button type="button" id="BtnLimpiarSolicitud" class="btn btn-secondary">
                                            <i class="icon-refresh"></i> Limpiar
                                        </button>
                                        <button type="button" id="BtnEnviarSolicitud" class="btn btn-success">
                                            <i class="icon-check"></i> Enviar Solicitud
                                        </button>
                                    </div>
                                </div>

                            </div>
                            <!-- ===================== FIN TAB: NUEVA SOLICITUD ===================== -->
                            <!-- ===================== TAB: MIS SOLICITUDES ===================== -->
                            <div class="tab-pane" id="tab-misSolicitudes" role="tabpanel" aria-labelledby="tab-misSolicitudes-tab">

                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped table-hover" id="tablaMisSolicitudes" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Solicitud</th>
                                                <th>Fecha</th>
                                                <th>Estado</th>
                                                <th>Observaciones</th>
                                                <th>Empleado</th>
                                                <th>Contacto</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyMisSolicitudes">
                                            <!-- DataTable la llena via ajax; ordenar por prioridad de Estado (Pendiente/Autorizada primero) -->
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                            <!-- ===================== FIN TAB: MIS SOLICITUDES ===================== -->

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- ===================== MODAL: DETALLE DE SOLICITUD ===================== -->
        <div class="modal fade" id="modalDetalleSolicitud" tabindex="-1" role="dialog" aria-hidden="true">

            <div class="modal-dialog modal-lg" role="document">

                <div class="modal-content">

                    <!-- HEADER -->
                    <div class="modal-header">

                        <div>
                            <h5 class="modal-title mb-1">
                                Detalle de Solicitud
                            </h5>

                            <div>
                                <strong>
                                    Solicitud:
                                    <span id="lblFolioModal" class="text-primary"></span>
                                </strong>

                                <span class="ml-3">
                                    <strong>Estado:</strong>
                                    <span id="lblEstadoModal"></span>
                                </span>
                            </div>
                        </div>

                        <button type="button"
                                class="close"
                                data-dismiss="modal"
                                aria-label="Close">

                            <span aria-hidden="true">&times;</span>

                        </button>

                    </div>


                    <!-- BODY -->
                    <div class="modal-body">

                        <h6 class="font-weight-bold mb-3">
                            Artículos solicitados
                        </h6>

                        <div class="table-responsive">

                            <table class="table table-bordered table-striped"
                                   id="tablaDetalleModal"
                                   width="100%">

                                <thead class="thead-light">
                                    <tr>
                                        <th>Codigo</th>
                                        <th>Articulo</th>
                                        <th>Unidades Solicitadas</th>
                                        <th>Unidades Entregadas</th>
                                        <th>Unidad Medición</th>
                                    </tr>
                                </thead>

                                <tbody id="tbodyDetalleModal">
                                </tbody>

                            </table>

                        </div>


                        <!-- OBSERVACIONES -->
                        <div class="row mt-3">

                            <div class="col-12 form-group">

                                <label class="font-weight-bold">
                                    Observaciones generales
                                </label>

                                <textarea id="InputObservacionesModal"
                                          class="form-control"
                                          rows="3"
                                          readonly
                                          placeholder="Sin observaciones">
                        </textarea>

                                <small class="text-muted">
                                    Las observaciones son únicamente informativas y no pueden ser modificadas.
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- FOOTER -->
                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-dismiss="modal">

                            Cerrar

                        </button>

                    </div>

                </div>

            </div>

        </div>
        <!-- ===================== FIN MODAL ===================== -->
        <!-- ===================== MODAL: DETALLE DE SOLICITUD ===================== -->
